{
  "expo": {
    "name": "Outsee",
    "slug": "outsee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.outsee.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8E6BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.outsee.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Outsee a besoin d'accéder à tes photos pour choisir une image.",
          "cameraPermission": "Outsee a besoin de la caméra pour prendre une photo de la soirée."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Outsee a besoin de la caméra pour scanner les pass à l'entrée."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Outsee a besoin de ta position pour te situer sur la carte des soirées."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111013",
          "image": "./assets/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111013",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "scheme": "outsee",
    "backgroundColor": "#111013"
  }
}

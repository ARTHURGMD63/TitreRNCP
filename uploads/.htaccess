# Le dossier d'upload ne sert que des fichiers statiques.
# Aucun script ne doit y être exécuté, même si un fichier malveillant
# parvenait à être déposé.

php_flag engine off

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Neutralise tout handler de script
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps

# Seules les images sont servies
<FilesMatch "(?i)\.(jpg|jpeg|png|webp)$">
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Le dossier d'upload ne sert que des fichiers statiques.
# Aucun script ne doit y être exécuté, même si un fichier malveillant
# parvenait à être déposé.

# Sous PHP-FPM (sans mod_php), php_flag provoque une erreur 500 sur toutes
# les images : la directive ne s'applique que là où mod_php existe. Les
# règles ci-dessous (RemoveHandler, refus des .php) couvrent les deux cas.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Neutralise tout handler de script
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps

# Seules les images sont servies
<FilesMatch "(?i)\.(jpg|jpeg|png|webp)$">
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

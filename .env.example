# Réglages lus par includes/config.php (reglage()) : variables d'environnement
# d'abord, puis includes/config.local.php. Sur le VPS, tout passe par
# config.local.php (modèle : deploy/config.local.production.example.php).

APP_ENV=local
APP_URL=http://localhost/TitreRNCP

# Base de données
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLDATABASE=outsee
MYSQLUSER=root
MYSQLPASSWORD=

# Paiement des établissements (Stripe) — laisser vide pour désactiver
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAUX_TVA=

# Surveillance : adresse qui reçoit les alertes de cron/sante.php (par défaut contact@outsee.fr).
# ALERTE_EMAIL=

# Adresse IP du visiteur pour les limiteurs : aucun, cloudflare ou x-forwarded-for
# (défaut : x-forwarded-for derrière un réseau privé seulement),
# et les proxys d'où l'en-tête est accepté (CIDR, « prive », « cloudflare »). Render :
# IP_ENTETE=x-forwarded-for
# PROXY_CONFIANCE=prive,cloudflare

# Environment
.env
.env.local
*.pem

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Node
node_modules/
package-lock.json
# Sauf celui de l'application mobile : la construction sur GitHub
# (npm ci) installe exactement les versions testees ici.
!mobile/package-lock.json

# Database
*.sqlite
*.db

# Composer / PHP tooling
# La barre oblique initiale compte. Sans elle, « vendor/ » designe un dossier
# de ce nom A N'IMPORTE QUELLE PROFONDEUR, et la regle emportait aussi
# assets/vendor/ — Chart.js, html5-qrcode et qrcode.min.js. Ces trois
# bibliotheques sont auto-hebergees et indispensables a l'execution : sans
# elles, le pass QR de l'etudiant ne s'affiche pas et le partenaire ne peut
# pas scanner. Elles ne sont pas des dependances Composer et n'ont rien a
# faire ici.
/vendor/
# composer.lock N'EST PAS ignore, et c'est deliberé : Linkee est une
# application, pas une bibliotheque. Le lock fige les versions exactes de
# PHPUnit et PHPStan ; sans lui, « composer install » se comporte comme un
# « composer update » et la CI peut valider le code contre des versions
# d'outils differentes de celles du poste de developpement — au moment
# precis ou l'on compte sur elle pour dire que tout va bien.
.phpunit.cache/
.phpunit.result.cache
coverage/
.phpstan.cache/

# Misc
.claude/
.git/

# Témoin local de __shot.php : ne doit jamais être déployé
.shot-enabled

# Documents internes fondateurs : budget, trésorerie, structure de la société,
# pacte d'associés, gouvernance. Le dépôt est public, ces pièces restent locales.
docs/fondateurs/

# Caches Python des générateurs de documents (docs/generate_*.py)
__pycache__/
*.pyc

# Contenus déposés par les utilisateurs. Les index.html sont des garde-fous
# (répertoires non listables) et doivent, eux, être versionnés.
uploads/*/*
!uploads/*/index.html

# Identifiants de base de données d'un hébergement mutualisé.
# Le modèle à recopier est includes/config.local.example.php.
includes/config.local.php

# Fichiers verrous d'Office (~$Document.pptx), crees a l'ouverture et
# supprimes a la fermeture. Le motif « *~ » ne les attrape pas : le tilde
# est en prefixe, pas en suffixe.
~$*

# ─── Livrables lourds : présents sur le disque, absents du dépôt ────────────
#
# Le dépôt portait 44 Mo de binaires : un teaser de 11 Mo, quatre versions
# du même diaporama pour 24 Mo, et sept PDF entièrement reconstructibles.
# Aucun n'est utilisé par l'application — rien dans le code ne les référence.
#
# Ce que ça coûtait : chaque clone les télécharge tous, et chaque nouvelle
# version d'un .pptx ajoute son poids entier à l'historique, définitivement.
# Un format binaire ne se « diffe » pas : Git en stocke une copie complète à
# chaque enregistrement. Le dépôt ne rétrécit jamais.
#
# Où ils vont : les fichiers restent sur le disque, ils ne sont simplement
# plus suivis. Voir docs/LIVRABLES.md pour où les déposer et comment
# regénérer ce qui est reconstructible.
#
# Ce qui RESTE versionné, et pourquoi : les .docx sources (1,4 Mo au total),
# qui ne se régénèrent depuis rien et dont le dépôt est la seule sauvegarde,
# et tout le HTML dont les PDF sont tirés.

# Médias et diaporamas
*.mp4
*.pptx

# PDF reconstructibles depuis le HTML versionné de docs/
docs/*.pdf
# et depuis Script_Oral_Linkee.docx
Script_Oral_Linkee.pdf

# ============================================================
#  Outsee — rotation des journaux de /var/log/outsee et
#  /var/log/outsee-sauvegarde
#  Installé dans /etc/logrotate.d/outsee (root, 644) par
#  installer_serveur.sh et appliquer_config.sh.
#
#  Ces journaux citent parfois des adresses e-mail : huit semaines de
#  conservation, pas davantage, puis suppression.
#
#  su www-data : le dossier appartient à www-data (les tâches planifiées y
#  écrivent), logrotate refuse sinon d'y travailler. PHP rouvre son journal
#  à chaque écriture : aucun rechargement de PHP-FPM n'est nécessaire.
# ============================================================
/var/log/outsee/*.log {
    su www-data www-data
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 640 www-data www-data
}

# Journal de la sauvegarde nocturne, écrit par root : dossier à root, pas de
# « su ». Même durée de conservation.
/var/log/outsee-sauvegarde/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 640 root root
}
